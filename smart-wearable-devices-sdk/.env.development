# 接口地址 (*)
# VITE_API_BASE = 'https://znzh.ydlweb.com'
VITE_API_BASE = 'http://127.0.0.1:8000'
# VITE_API_BASE = 'http://192.168.1.254:8127'
# App 端（含自定义基座）接口地址覆盖 (*)
# 运行到自定义基座同样走 development 模式，而真机上的 127.0.0.1 指向手机自身，
# 访问不到电脑上的 VITE_API_BASE，所有请求都会失败（典型表现：收不到短信验证码）。
# 因此 App 端固定指向一个真机可达的后端；留空则回退到 VITE_API_BASE。
# VITE_API_BASE_APP = 'http://192.168.1.254:8127'
VITE_API_BASE_APP = 'https://sh.qkeering.com'
VITE_ERROR_TOAST_ENABLED = false
