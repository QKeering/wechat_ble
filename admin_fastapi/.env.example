APP_NAME=QKeer Admin FastAPI
ENV=development
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/znzh_ydlweb_com?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

TOKEN_HEADER=Authorization
TOKEN_PREFIX=Bearer 
TOKEN_SECRET=change-me
ADMIN_TOKEN_EXPIRE_MINUTES=30
APP_TOKEN_EXPIRE_MINUTES=43200

CORS_ORIGINS=http://localhost,http://127.0.0.1:80,http://127.0.0.1:5173
UPLOAD_DIR=upload
OTHER_API_BASE_URL=

# 小轻AI成长闺蜜：大模型/语音能力
# growth_ai_provider: qwen 或 doubao
GROWTH_AI_PROVIDER=qwen
DASHSCOPE_API_KEY=
DASHSCOPE_CHAT_MODEL=qwen3.7-plus
DASHSCOPE_COMPATIBLE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_CHAT_MODEL=

# 阿里百炼语音识别/语音合成，key 后补；endpoint 留空时接口返回 pending_key 降级结果
ALI_ASR_API_KEY=
ALI_ASR_MODEL=qwen3-asr-flash
ALI_ASR_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/audio/asr/transcription
ALI_TTS_API_KEY=
ALI_TTS_MODEL=cosyvoice-v3.5-flash
ALI_TTS_VOICE=longxiaochun
ALI_TTS_FALLBACK_MODEL=qwen-tts
ALI_TTS_FALLBACK_VOICE=Cherry
ALI_TTS_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2audio/speech-synthesis
APP_PUBLIC_BASE_URL=
SLEEPFM_SERVICE_TOKEN=replace-with-a-strong-service-token
SLEEPFM_HASH_SECRET=replace-with-a-stable-private-hash-secret
# Comma-separated internal user IDs or user codes with sleepfm_research_eval consent.
SLEEPFM_CONSENTED_USER_IDS=
